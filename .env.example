# ---------------------------------------------------------------
# Sanity — content backend
# Find these at https://sanity.io/manage after creating a project.
# The two NEXT_PUBLIC_ values are safe to expose; the two below are not.
# ---------------------------------------------------------------

# Your Sanity project ID. Until this is set the site builds and runs, but
# every page renders its empty state.
NEXT_PUBLIC_SANITY_PROJECT_ID=

# Usually "production".
NEXT_PUBLIC_SANITY_DATASET=production

# Pin the API to a date so a future Sanity release cannot change query
# behaviour underneath you.
NEXT_PUBLIC_SANITY_API_VERSION=2026-08-01

# ---------------------------------------------------------------
# Server-only — never prefix these with NEXT_PUBLIC_
# ---------------------------------------------------------------

# Viewer token, from Sanity → API → Tokens. Only needed if you later add
# draft previews; normal published reads do not use it.
SANITY_API_READ_TOKEN=

# Any long random string. Paste the same value into the Sanity webhook's
# secret field so the revalidate route can verify the request really came
# from Sanity. Generate one with:  openssl rand -base64 32
SANITY_REVALIDATE_SECRET=

# ---------------------------------------------------------------
# Site
# ---------------------------------------------------------------

# Canonical URL. Used for metadata, Open Graph, sitemap, and the RSS feed.
# Locally you can leave this unset; it falls back to http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://your-domain.com
