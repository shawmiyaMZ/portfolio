# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the template. It carries no secrets and it is the documentation
# of every variable the project needs, so it has to be in the repo.
!.env.example

# vercel
.vercel

# The assignment brief. It stays on disk — it is the document this project
# answers to, and every decision here should be checkable against it — but it
# belongs to the course, not to this repository, so it is not published.
docs/brief.md

# agent tooling
# Local development aids, not part of the portfolio. Kept out so the repo
# reads as the project rather than as the toolchain used to build it.
# AGENTS.md and CLAUDE.md stay tracked — they are project instructions.
/.claude/
/_bmad/
/_bmad-output/

# typescript
*.tsbuildinfo
next-env.d.ts

dev-server.log
